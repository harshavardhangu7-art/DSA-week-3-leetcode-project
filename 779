class Solution {
    public int kthGrammar(int n, int k) {
        // Base case: the first row only contains 0
        if (n == 1) {
            return 0;
        }

        // Half the length of row n (which is 2^(n-2))
        int mid = 1 << (n - 2);

        if (k <= mid) {
            // First half is identical to the previous row
            return kthGrammar(n - 1, k);
        } else {
            // Second half is the complement of the previous row
            return 1 - kthGrammar(n - 1, k - mid);
        }
    }
}
